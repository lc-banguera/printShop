# PrintShop backend environment
# Copy this file to server/.env and fill in your real test credentials only in the local backend.

PORT=3001
CLIENT_URL=https://road-contained-arabia-unsigned.trycloudflare.com
FRONTEND_URL=https://road-contained-arabia-unsigned.trycloudflare.com
APP_URL=https://appreciate-considering-motels-wanted.trycloudflare.com

BACKEND_PUBLIC_URL=https://domains-beta-came-maintaining.trycloudflare.com

# Mercado Pago test credentials (private; keep only in backend)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PUBLIC_KEY=

# Didit V3 (backend-only secrets). Configure the Free KYC workflow ID in Didit Console.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Existing authentication must issue HS256 access tokens with a string `sub` and future `exp`.
# Do not expose this value to the frontend.
PRINTSHOP_AUTH_JWT_SECRET=
# Optional: PRINTSHOP_AUTH_JWT_ISSUER=


# Set BACKEND_PUBLIC_URL to an HTTPS tunnel when Mercado Pago must reach the webhook.

# Required only when the Enterprise price is defined for checkout.
# ENTERPRISE_MONTHLY_PRICE=

# App configuration
NODE_ENV=development
